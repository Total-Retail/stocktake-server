# ── Required — app will not start without these ───────────────────────────────
DB_PASSWORD=change_me_strong_password
REDIS_PASSWORD=change_me_redis_password

# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret_at_least_32_chars_long
OTP_SECRET=change_me_otp_secret_at_least_32_chars_long

# ── SMS gateway — required for OTP delivery to counters ───────────────────────
# Base URL up to (but not including) /send  e.g. https://yourdomain.com/api/v1/sms
SMS_BASE_URL=https://yourdomain.com/api/v1/sms
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER=StockCount

# ── LS Commerce Service — required for worksheet pull and final submission ────
LS_BASE_URL=https://your-bc-server/BC220/ODataV4
LS_USERNAME=your_bc_service_username
LS_PASSWORD=your_bc_service_password
LS_COMPANY_ID=your_bc_company_id

# ── ERP backend — which ERP this deployment talks to ──────────────────────────
# "ls" (default): LS Central on-prem, using the LS_* variables above.
# "vantage": Vantage Retail on Business Central online, using VANTAGE_* below.
# Any other value stops the server at startup.
ERP_BACKEND=ls

# ── Vantage Retail (Business Central online) — required when ERP_BACKEND=vantage
# Entra ID tenant (GUID or domain) that owns the Business Central environment
VANTAGE_TENANT_ID=
# Business Central environment name, e.g. Production or Sandbox
VANTAGE_ENVIRONMENT=
# Company id (GUID) from GET .../api/v2.0/companies
VANTAGE_COMPANY_ID=
# App registration (client credentials) granted access in Business Central
VANTAGE_CLIENT_ID=
VANTAGE_CLIENT_SECRET=

# ── Optional tuning (defaults shown) ─────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_REQUESTS=3
COUNTER_TOKEN_HOURS=12
ADMIN_TOKEN_HOURS=8
VARIANCE_TOLERANCE_PCT=2.0

#trigger
