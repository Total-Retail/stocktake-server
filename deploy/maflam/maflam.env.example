# Maflam Trading - one deployment target (copy to .env.maflam-testing / .env.maflam-live,
# next to docker-compose.yml; git ignores .env.*). deploy/maflam/setup-github.ps1 puts these
# into the GitHub environment maflam-<target>: secrets as secrets, the rest as variables.
# Values are taken literally: no quotes needed, and no ' or line breaks allowed.

# -- The Linux box (deploy/maflam/server-bootstrap.sh prepares it; same for both) --
SSH_HOST=
SSH_PORT=22
SSH_USER=deploy
# Path to the private key the workflow logs in with (its .pub is in the server's
# ~deploy/.ssh/authorized_keys). Relative paths are from stocktake-server/. Becomes the
# SSH_PRIVATE_KEY secret; the file itself stays on your machine.
SSH_PRIVATE_KEY_FILE=
# The server's host key line(s). Leave empty: the setup script reads it with ssh-keyscan.
SSH_KNOWN_HOSTS=
# Testing and live share one box as separate stacks. Each has its own directory and its
# own port on 127.0.0.1 (used when nginx runs on the host). Defaults when empty:
#   testing  APP_DIR=/opt/stocktake/testing  HTTP_PORT=8085
#   live     APP_DIR=/opt/stocktake/live     HTTP_PORT=8084
APP_DIR=
HTTP_PORT=
# Behind the nginx already on the box (as 3retail-licensing, EDGE_MODE=proxy).
# PROXY_NETWORK: the docker network of the nginx container; empty = nginx on the host, which
# proxies the domain to 127.0.0.1:HTTP_PORT. setup-github.ps1 finds it on the box when empty.
PROXY_NETWORK=
# LETSENCRYPT_HOST for nginx-proxy's acme-companion: auto (if it runs on the box) | yes | no
PROXY_LETSENCRYPT=auto
# The https address devices and the portal use (the box's nginx serves it), e.g.
# https://maflam.stockcount-test.totalretailzw.com - the app's release build only connects over https.
PUBLIC_URL=
# Portal live-monitor websocket; empty = PUBLIC_URL with wss://
PUBLIC_WS_URL=

# -- What the Vantage Suite setup screen shows for this server --------------------
DEPLOYMENT_NAME=Maflam Trading

# -- Vantage Retail on Business Central online (ERP_BACKEND is always vantage) ----
VANTAGE_TENANT_ID=
# Business Central environment name, e.g. DEV / Sandbox for testing, Production for live
VANTAGE_ENVIRONMENT=
# Company id (GUID) of Maflam Trading in that environment
VANTAGE_COMPANY_ID=
# Entra app registration (client credentials) with Vantage Retail - All in BC
VANTAGE_CLIENT_ID=
VANTAGE_CLIENT_SECRET=

# -- This server's own secrets: leave empty, the setup script generates them once -
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
OTP_SECRET=

# -- SMS gateway for counters' sign-in codes (optional until counters use OTP) ----
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER=VantageSuite

# -- Optional tuning (defaults shown) ---------------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_MAX_REQUESTS=3
COUNTER_TOKEN_HOURS=12
ADMIN_TOKEN_HOURS=8
DEVICE_TOKEN_DAYS=365
VARIANCE_TOLERANCE_PCT=2.0
